# Patent Agent System - Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# LLM API Keys
# ============================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# Patent Database APIs
# ============================================
# KIPRIS (Korean Intellectual Property Rights Information Service)
KIPRIS_API_KEY=your_kipris_api_key_here

# USPTO (United States Patent and Trademark Office)
# USPTO_API_KEY=your_uspto_api_key_here

# Google Patents (via SerpAPI)
SERPAPI_API_KEY=your_serpapi_api_key_here

# ============================================
# Vector Store
# ============================================
CHROMA_PERSIST_DIRECTORY=./data/chroma

# ============================================
# Monitoring (Opik)
# ============================================
# OPIK_API_KEY=your_opik_api_key_here
# OPIK_PROJECT_NAME=patent-agent-system

# ============================================
# Application Settings
# ============================================
LOG_LEVEL=INFO
ENVIRONMENT=development
